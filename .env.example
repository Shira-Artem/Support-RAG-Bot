# 1) Создай бота через @BotFather и вставь токен
TELEGRAM_BOT_TOKEN=123456789:PASTE_TELEGRAM_TOKEN_HERE

# 2) Необязательно: ключ OpenRouter включает генерацию ответа через LLM.
# Без него бот покажет релевантные фрагменты из локальной базы знаний.
# Создать ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=PASTE_OPENROUTER_KEY_HERE

# Модель можно менять. Для старта удобно openrouter/auto.
OPENROUTER_MODEL=openrouter/auto

# Необязательно: название приложения для OpenRouter
APP_NAME=Support RAG Bot
APP_URL=http://localhost

# 1 = добавлять в ответ краткий список источников из локальной базы знаний
SHOW_SOURCES=1
