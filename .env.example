# 1) Создай бота через @BotFather и вставь токен
TELEGRAM_BOT_TOKEN=

# 2) Необязательно: ключ OpenRouter включает генерацию ответа через LLM.
# Без него бот покажет релевантные фрагменты из локальной базы знаний.
# Создать ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Модель можно менять. Для старта удобно openrouter/auto.
OPENROUTER_MODEL=openrouter/auto

# Provider for answer generation: openrouter or groq
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# Comma-separated numeric Telegram user IDs allowed to use /expert
EXPERT_TELEGRAM_IDS=

# Необязательно: название приложения для OpenRouter
APP_NAME=Support RAG Bot
APP_URL=http://localhost

# 1 = добавлять в ответ краткий список источников из локальной базы знаний
SHOW_SOURCES=1

# Production search: only approved documents. Demo is explicit and separate.
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=knowledge_v1
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_DEMO_MODE=0
RAG_BACKEND=qdrant

# Optional process-scoped pilot switch. Keep legacy by default.
# If Source-first is enabled and SOURCE_FIRST_TELEGRAM_IDS is empty,
# the existing EXPERT_TELEGRAM_IDS list is reused as explicitly authorized.
RAG_ENGINE=legacy
SOURCE_FIRST_TELEGRAM_IDS=
