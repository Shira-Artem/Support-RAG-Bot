          "section": "Вопрос пользователя",
          "position": 1,
          "text": "Что такое ОФД и почему без него касса не передаёт чеки в ФНС?",
          "kind": "sentence",
          "scope": {
            "status": "approved",
            "service": "АТОЛ Онлайн",
            "task_category": "ofd_connection",
            "manufacturer": "АТОЛ",
