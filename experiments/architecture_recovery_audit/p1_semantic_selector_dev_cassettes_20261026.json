          "document_id": "platformaofd-lkk-receipt-search",
          "source": "data/knowledge/platformaofd/ofd/lkk-receipt-search.md",
          "source_sha256": "500cb603915289abe98cf590acf18db7acf902ddc57fb9284db70c098c85767c",
          "section": "Дополнительные условия",
          "position": 2,
          "text": "Для дополнительного тега задаётся его значение; пустое значение отбирает документы с заполненным выбранным тегом.",
          "kind": "sentence",
          "scope": {
            "status": "approved",
            "service": "Платформа ОФД",
            "task_category": "receipt_search",
            "manufacturer": null,
